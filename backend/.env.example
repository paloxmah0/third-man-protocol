DATABASE_URL=sqlite://./thirdman.db?mode=rwc
LISTEN_ADDR=127.0.0.1:8080
RUST_LOG=third_man_backend=info,tower_http=info

# Plutus escrow validator — compiled from onchain/plutus.json (Aiken Plutus V3)
# NOTE: This is the placeholder validator (always fails with `todo`).
# After rebooting for WSL, compile the real validator to get the real hash.
ESCROW_VALIDATOR_SCRIPT_HASH=f2388d136606a27c4a531d0040c3e12e07eb95cd5011793c160707dc
# The script address is computed by Lucid at runtime via validatorToAddress("Preprod", script).
# This placeholder is not used — Lucid computes the real address from the compiled code.
ESCROW_VALIDATOR_ADDR=addr_test1w000000000000000000000000000000000000000000000000000

# Oracle endpoint (delivery / external data). Failures must be non-fatal.
ORACLE_ENDPOINT=https://oracle.example.com/query

# Points awarded per successful contract, used for arbiter governance trust.
POINTS_PER_SUCCESS=10

# OTP link defaults
OTP_DEFAULT_TTL_SECONDS=3600
OTP_DEFAULT_MAX_USES=1

# Collateral: base + weight-scaled bps of agreement value (basis points, 1% = 100)
COLLATERAL_BASE_LOVELACE=2000000
COLLATERAL_BPS=500
COLLATERAL_MAX_LOVELACE=20000000
